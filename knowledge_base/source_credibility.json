{
  "$schema": "CDM/DRR Source Credibility Registry v1.0",
  "description": "Granular credibility scoring for sources beyond simple tier mapping",
  "version": "1.0",
  "last_updated": "2025-12-21",

  "credibility_dimensions": {
    "accuracy": {
      "weight": 0.35,
      "description": "Historical accuracy of CDM-related claims"
    },
    "specificity": {
      "weight": 0.25,
      "description": "Level of technical detail provided"
    },
    "verification_rate": {
      "weight": 0.20,
      "description": "How often claims can be independently verified"
    },
    "recency_bias": {
      "weight": 0.10,
      "description": "Tendency to favor recent vs. comprehensive coverage"
    },
    "vendor_affinity": {
      "weight": 0.10,
      "description": "Known commercial relationships (negative signal)"
    }
  },

