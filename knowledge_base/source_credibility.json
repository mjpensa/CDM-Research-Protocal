  "bias_registry": {
    "description": "Sources with documented bias patterns",
    "sources_with_known_bias": [
      {
        "source_pattern": "*.vendor.com/press-release/*",
        "bias_type": "promotional",
        "adjustment_factor": 0.6,
        "mitigation": "Require bank confirmation for customer claims"
      },
      {
        "source_pattern": "linkedin.com/posts/*",
        "bias_type": "self_promotional",
        "adjustment_factor": 0.7,
        "mitigation": "Corroborate with official sources"
      },
      {
        "source_pattern": "*.consultancy.com/insights/*",
        "bias_type": "lead_generation",
        "adjustment_factor": 0.8,
        "mitigation": "Focus on factual claims, discount predictions"
      }
    ]
  },

  "usage_notes": [
    "composite_score is weighted sum of credibility_scores",
    "lr_multiplier adjusts the base LR from bayesian-lr-tables.json",
    "vendor_affinity should be subtracted from (1 - vendor_affinity) for final score",
    "Domains not listed should use tier-based defaults from CLAUDE.md"
  ]
}
