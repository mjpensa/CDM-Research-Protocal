  "translation_guidance": {
    "recommended_tools": [
      "Google Translate for initial pass",
      "DeepL for more accurate translations",
      "Native speaker verification for critical claims"
    ],
    "verification_rules": [
      "Translate headlines and first paragraphs first",
      "Verify technical terms (CDM, derivatives, etc.) aren't mistranslated",
      "Cross-reference with English-language versions if available",
      "Quote original language in evidence.json, provide translation in notes"
    ]
  },

  "search_strategy": {
    "description": "How to search non-English sources",
    "steps": [
      "Start with English version of site if available",
      "Use local-language search terms for deeper coverage",
      "Search bank name in local script (e.g., 野村 for Nomura)",
      "Search regulatory terms in local language"
    ],
    "common_cdm_translations": {
      "Japanese": {
