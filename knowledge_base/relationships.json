{
  "$schema": "CDM/DRR Entity Relationships v1.0",
  "description": "Entity relationship graph for network effect analysis and pressure inference",
  "version": "1.0",
  "last_updated": "2025-12-21",

  "relationship_types": {
    "vendor_partnership": {
      "description": "Bank uses vendor for CDM-related services",
      "directionality": "bank_to_vendor",
      "decay_months": 24,
      "default_pressure": "pragmatist",
      "pressure_strength": 0.7,
      "rationale": "Vendor relationships often indicate outsourcing preference"
    },
    "ccp_connectivity": {
      "description": "Bank has clearing relationship with CCP",
      "directionality": "bank_to_ccp",
      "decay_months": 36,
      "default_pressure": "depends_on_ccp",
      "pressure_strength": 0.9,
      "rationale": "CCPs mandating CDM create strong ARCHITECT pressure"
    },
    "peer_adoption": {
      "description": "Peer bank has adopted CDM",
      "directionality": "bidirectional",
      "decay_months": 18,
      "default_pressure": "architect",
      "pressure_strength": 0.4,
      "rationale": "Peer pressure and follow-the-leader dynamics"
    },
    "counterparty_pressure": {
      "description": "Major counterparty requires CDM compatibility",
      "directionality": "counterparty_to_bank",
      "decay_months": 12,
      "default_pressure": "architect",
      "pressure_strength": 0.6,
      "rationale": "Business pressure from trading counterparties"
    },
    "consortium_member": {
      "description": "Member of CDM-related consortium or working group",
      "directionality": "bidirectional",
      "decay_months": 24,
      "default_pressure": "architect",
      "pressure_strength": 0.3,
      "rationale": "Indicates awareness and potential investment"
    },
    "finos_contributor": {
      "description": "Active contributor to FINOS CDM repository",
      "directionality": "bank_to_finos",
      "decay_months": 36,
      "default_pressure": "architect",
      "pressure_strength": 0.8,
      "rationale": "Code contributions indicate significant investment"
    },
    "regulatory_mandate": {
      "description": "Bank subject to CDM-relevant regulatory mandate",
      "directionality": "regulator_to_bank",
      "decay_months": 48,
      "default_pressure": "depends_on_mandate",
      "pressure_strength": 0.85,
      "rationale": "Regulatory deadlines create strong adoption pressure"
    }
  },

