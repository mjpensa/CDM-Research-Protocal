  "product_types": {
    "description": "Derivative product types for granular analysis",
    "types": [
      {
        "id": "irs",
        "display_name": "Interest Rate Derivatives",
        "products": ["IRS", "swaptions", "caps", "floors", "basis_swaps"]
      },
      {
        "id": "credit",
        "display_name": "Credit Derivatives",
        "products": ["CDS", "CDX", "iTraxx", "CLN"]
      },
      {
        "id": "fx",
        "display_name": "FX Derivatives",
        "products": ["FX_forwards", "FX_options", "FX_swaps", "NDFs"]
      },
      {
        "id": "equity",
        "display_name": "Equity Derivatives",
        "products": ["equity_options", "equity_swaps", "variance_swaps", "dividend_swaps"]
      },
      {
        "id": "commodity",
        "display_name": "Commodity Derivatives",
        "products": ["commodity_futures", "commodity_options", "commodity_swaps"]
      }
    ]
  },

  "relationship_types": {
    "description": "Valid relationship types between entities",
    "types": [
      {"id": "uses_platform", "source_types": ["bank"], "target_types": ["vendor"]},
      {"id": "clears_at", "source_types": ["bank"], "target_types": ["ccp"]},
      {"id": "trades_with", "source_types": ["bank"], "target_types": ["bank"]},
      {"id": "regulated_by", "source_types": ["bank", "vendor", "ccp"], "target_types": ["regulator"]},
      {"id": "advised_by", "source_types": ["bank"], "target_types": ["consultant"]},
      {"id": "competes_with", "source_types": ["bank", "vendor"], "target_types": ["bank", "vendor"]},
      {"id": "partners_with", "source_types": ["bank", "vendor", "ccp"], "target_types": ["bank", "vendor", "ccp"]},
      {"id": "acquired", "source_types": ["bank", "vendor"], "target_types": ["bank", "vendor"]},
      {"id": "subsidiary_of", "source_types": ["bank", "vendor"], "target_types": ["bank", "vendor"]},
      {"id": "integrates_with", "source_types": ["vendor"], "target_types": ["ccp", "vendor"]}
    ]
  },

  "output_structure": {
    "description": "v5.0 output directory structure",
    "pattern": "outputs/{entity_type}/{entity_id}/{domain_type}/",
    "legacy_pattern": "outputs/phase-{N}/{bank_id}/",
    "example": "outputs/banks/deutsche-bank/tech-stack/evidence.json"
  },

  "research_ordering": {
    "description": "Order of research execution",
    "strategy": "all_domains_per_entity",
    "entity_type_order": ["bank", "vendor", "ccp", "regulator", "consultant"],
    "note": "Complete all 7 domains for one entity before moving to next entity"
  },

  "backward_compatibility": {
    "description": "Compatibility with v4.x bank-only research",
    "bank_id_mapping": "entity_id for entity_type=bank",
    "bank_name_mapping": "entity_name for entity_type=bank",
    "legacy_outputs_supported": true,
    "migration_tool": "tools/migrate_v4_to_v5.py"
  }
}
