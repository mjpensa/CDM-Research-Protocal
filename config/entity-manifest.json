    "people_talent": {
      "source_file": "config/domains/people-talent.json",
      "display_name": "People & Talent",
      "workflow": "simplified",
      "description": "Key personnel, hiring patterns, team structures"
    },
    "regulatory_posture": {
      "source_file": "config/domains/regulatory-posture.json",
      "display_name": "Regulatory Posture",
      "workflow": "simplified",
      "description": "Enforcement history, compliance investments, regulator relationships"
    },
    "financial_metrics": {
      "source_file": "config/domains/financial-metrics.json",
      "display_name": "Financial Metrics",
      "workflow": "simplified",
