    },
    "consultant": {
      "source_file": "config/entities/consultants.json",
      "applicable_domains": [
        "people_talent",
        "strategic_direction"
      ],
      "count": 5,
      "description": "Consulting firms advising on derivatives technology and strategy"
    }
  },

  "domain_registry": {
    "cdm_adoption": {
      "source_file": "config/domains/cdm-adoption.json",
