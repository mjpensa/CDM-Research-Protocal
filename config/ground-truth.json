  "validation_rules": {
    "time_based_resolution": {
      "description": "When no announcement occurs, infer PRAGMATIST outcome",
      "months_without_announcement": 18,
      "confidence_for_inference": 75,
      "outcome_type": "time_based_absence"
    },
    "contradicting_outcome": {
      "description": "How to handle an outcome that contradicts prediction",
      "record_squared_error": true,
      "flag_for_lr_review": true,
      "update_evidence_patterns": true
    }
  },

  "usage_notes": [
    "Immutable anchor points have validation_confidence=100 and cannot be changed",
    "pending_validations are predictions awaiting outcome; validated_outcomes have confirmed results",
    "lr_accuracy_tracking tracks observed vs assumed LR to identify miscalibrated evidence types",
    "Sample size must reach minimum_sample_for_observed_lr before observed_lr can be calculated"
  ]
