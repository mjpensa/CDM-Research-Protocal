{
  "$schema": "Domain Configuration v1.0",
  "domain_id": "strategic_direction",
  "display_name": "Strategic Direction",
  "description": "Investor communications, M&A activity, stated priorities for derivatives business",
  "version": "1.0",
  "last_updated": "2025-12-22",

  "workflow": {
    "type": "simplified",
    "stages": 5,
    "description": "Simplified workflow without Bayesian/adversarial stages",
    "stages_list": [
      "initialize", "evidence_collection", "source_verification", "synthesis", "report"
    ]
  },

  "applicable_entity_types": ["bank", "vendor", "ccp", "regulator", "consultant"],

  "source_authority": {
    "tier1": {
      "description": "Official sources",
      "max_confidence": 0.95,
      "sources": [
        "Investor day presentations",
        "Annual reports (strategy sections)",
        "SEC filings (MD&A)",
        "Official press releases",
        "CEO/CFO letters to shareholders"
      ]
    },
    "tier2": {
      "description": "Analyst and press sources",
      "max_confidence": 0.75,
      "sources": [
        "Earnings call transcripts",
        "Analyst reports",
        "Trade press strategic coverage",
        "M&A announcements"
      ]
    },
    "tier3": {
      "description": "Commentary sources",
      "max_confidence": 0.50,
      "sources": [
        "Industry commentary",
        "LinkedIn posts from executives",
        "Conference remarks",
        "Blog analysis"
      ]
    }
  },

  "classification_taxonomy": [
    {
      "id": "expanding",
      "label": "Expanding",
      "description": "Growing derivatives business, active investment",
      "indicators": ["Investment announcements", "M&A activity", "Hiring", "New product launches"]
    },
    {
      "id": "optimizing",
      "label": "Optimizing",
      "description": "Maintaining position, efficiency focus",
      "indicators": ["Efficiency programs", "Stable footprint", "Technology modernization"]
    },
    {
      "id": "restructuring",
      "label": "Restructuring",
      "description": "Strategic review, portfolio changes underway",
      "indicators": ["Strategic review announced", "Portfolio changes", "Leadership changes"]
    },
    {
      "id": "exiting",
      "label": "Exiting",
      "description": "Reducing derivatives exposure, divesting",
      "indicators": ["Divestiture announcements", "Exit from products/regions", "Wind-down"]
    },
    {
      "id": "unknown",
      "label": "Unknown",
      "description": "Insufficient evidence to classify",
      "indicators": []
    }
  ],

