{
  "$schema": "Domain Configuration v1.0",
  "domain_id": "counterparty",
  "display_name": "Counterparty Relationships",
  "description": "CCP memberships, bilateral relationships, netting agreements",
  "version": "1.0",
  "last_updated": "2025-12-22",

  "workflow": {
    "type": "simplified",
    "stages": 5,
    "description": "Simplified workflow without Bayesian/adversarial stages",
    "stages_list": [
      "initialize", "evidence_collection", "source_verification", "synthesis", "report"
    ]
  },

  "applicable_entity_types": ["bank", "ccp"],

  "source_authority": {
    "tier1": {
      "description": "Official sources",
      "max_confidence": 0.95,
      "sources": [
        "CCP membership lists",
        "Regulatory filings (Form 10-K, Pillar 3)",
        "Annual reports (counterparty disclosures)",
        "Official clearing member directories"
      ]
    },
    "tier2": {
      "description": "Industry sources",
      "max_confidence": 0.75,
      "sources": [
        "Deal announcements",
        "Industry databases",
        "Trade press coverage",
        "Prime broker rankings"
      ]
    },
    "tier3": {
      "description": "Signal sources",
      "max_confidence": 0.50,
      "sources": [
        "Market rumors",
        "LinkedIn connections",
        "Conference networking reports"
      ]
    }
  },

  "classification_taxonomy": [
    {
      "id": "dealer",
      "label": "Major Dealer",
      "description": "Top-tier market maker with extensive counterparty network",
      "indicators": ["G-SIB designation", "Multiple CCP memberships", "High notional volumes"]
    },
    {
      "id": "active_participant",
      "label": "Active Participant",
      "description": "Regular derivatives activity with moderate counterparty network",
      "indicators": ["Select CCP memberships", "Moderate volumes", "Active bilateral trading"]
    },
    {
      "id": "end_user",
      "label": "End User",
      "description": "Uses derivatives primarily for hedging with limited counterparties",
      "indicators": ["Client clearing", "Hedging focus", "Limited dealer relationships"]
    },
    {
      "id": "unknown",
      "label": "Unknown",
      "description": "Insufficient evidence to classify",
      "indicators": []
    }
  ],

  "claim_types": [
    {
      "id": "ccp_membership",
      "label": "CCP Membership",
      "description": "Confirmed clearing member at CCP"
    },
    {
      "id": "bilateral_relationship",
      "label": "Bilateral Relationship",
      "description": "Evidence of direct trading relationship"
    },
    {
      "id": "regulatory_filing",
      "label": "Regulatory Filing",
      "description": "Counterparty exposure disclosed in regulatory reports"
    },
    {
      "id": "news_mention",
      "label": "News Mention",
      "description": "Trade relationship mentioned in press"
    },
    {
      "id": "inference_from_deals",
      "label": "Inference from Deals",
      "description": "Implied relationship from deal announcements"
    },
    {
      "id": "prime_broker_relationship",
      "label": "Prime Broker Relationship",
      "description": "Prime brokerage or clearing relationship"
    }
  ],

  "key_questions": [
    "Which CCPs is the entity a clearing member of?",
    "What bilateral trading relationships are documented?",
    "What netting agreements exist?",
    "What is counterparty exposure (from regulatory filings)?",
    "Who are their prime broker relationships?",
    "What clearing volumes are disclosed?"
  ],

  "ccps_of_interest": [
    {"id": "lch", "products": ["SwapClear", "ForexClear", "CDSClear"]},
    {"id": "cme", "products": ["CME Clearing", "CME ClearPort"]},
    {"id": "ice-clear", "products": ["ICE Clear US", "ICE Clear Europe", "ICE Clear Credit"]},
    {"id": "eurex", "products": ["Eurex OTC Clear"]},
    {"id": "jscc", "products": ["JSCC IRS Clearing", "JSCC CDS Clearing"]},
    {"id": "dtcc", "products": ["GTR", "TIW", "FICC"]},
    {"id": "sgx", "products": ["SGX DC"]},
    {"id": "hkex", "products": ["OTC Clear"]}
  ],

  "relationship_categories": [
    {
      "id": "clearing_member",
      "label": "Clearing Member",
      "description": "Direct clearing member at CCP"
    },
    {
      "id": "client_clearer",
      "label": "Client Clearer",
      "description": "Clears through another member"
    },
    {
      "id": "bilateral_counterparty",
      "label": "Bilateral Counterparty",
      "description": "Non-cleared trading relationship"
    },
    {
      "id": "prime_broker_client",
      "label": "Prime Broker Client",
      "description": "Uses prime broker for clearing/execution"
    }
  ]
}
