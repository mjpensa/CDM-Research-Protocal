  "calculation_instructions": {
    "step1_prior_odds": {
      "formula": "Prior Odds = P(Architect) / P(Pragmatist)",
      "example": "0.30 / 0.70 = 0.43"
    },
    "step2_combined_lr": {
      "formula": "Combined LR = LR₁ × LR₂ × LR₃ × ... × LRₙ",
      "example": "14 × 5 × 0.21 = 14.7",
      "note": "Multiply all likelihood ratios from all evidence"
    },
    "step3_posterior_odds": {
      "formula": "Posterior Odds = Prior Odds × Combined LR",
      "example": "0.43 × 14.7 = 6.32"
    },
    "step4_posterior_probability": {
      "formula": "P(Architect | Evidence) = Posterior Odds / (1 + Posterior Odds)",
      "example": "6.32 / (1 + 6.32) = 6.32 / 7.32 = 0.86 = 86%"
    },
    "step5_determine_variant": {
      "condition": "If P(Architect) > 50%",
      "rules": {
        "native": "Production confirmed",
        "leader": "Production committed",
        "follower": "Contributing without production"
      }
    }
  },

  "calibration_checks": {
    "extreme_lrs": {
      "condition": "Combined LR > 100 or < 0.01",
      "checks": [
        "Are you double-counting the same evidence?",
        "Is a single piece of evidence carrying too much weight?",
        "Have you correctly identified the evidence type?"
      ]
    },
    "belief_reversal": {
      "condition": "Posterior is opposite prior (e.g., 80% Pragmatist → 80% Architect)",
      "checks": [
        "Is the evidence really that strong?",
        "Could there be a simpler explanation?",
        "Does this pass the 'would I bet at these odds' test?"
      ]
    },
    "unchanged_beliefs": {
      "condition": "Posterior ≈ Prior despite substantial searching",
      "checks": [
        "Did you find genuinely uninformative evidence (all LR ≈ 1)?",
        "Or did positive and negative evidence cancel out (worth noting)?",
        "Is 'unchanged with more confidence' the right interpretation?"
      ]
    }
  },

  "independence_note": "Multiplying LRs assumes evidence is independent. If two pieces of evidence come from the same source or are causally linked, do not count both fully.",

  "missing_evidence_guidance": "If you encounter evidence not in the tables, estimate LR by asking: 'How much more likely is this if Architect vs. Pragmatist?'"
}
