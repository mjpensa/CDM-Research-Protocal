{
  "$schema": "CDM Research API Configuration v1.0",
  "description": "Configuration for Claude API integration",

  "model": {
    "primary": "claude-opus-4-5-20250101",
    "fallback": "claude-sonnet-4-20250514",
    "note": "Primary model for research; fallback for retries on rate limits"
  },

  "retry": {
    "max_retries": 3,
    "retry_delay_seconds": 5,
    "exponential_backoff": true,
    "max_delay_seconds": 60
  },

  "timeouts": {
    "request_timeout_seconds": 300,
    "evidence_gathering_timeout_seconds": 600,
    "synthesis_timeout_seconds": 900
  },

  "rate_limiting": {
    "requests_per_minute": 50,
    "tokens_per_minute": 100000,
    "concurrent_requests": 3
  },

  "tools": {
    "web_search_enabled": true,
    "web_search_tool_name": "web_search_20250305"
  }
}
