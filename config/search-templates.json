  "null_result_guidance": {
    "description": "Guidance for when searches return no results",
    "reformulation_iterations": 4,
    "reformulation_strategies": [
      "Remove one search term",
      "Try synonyms (CDM → 'Common Domain Model' → 'regulatory reporting')",
      "Broader search (ISDA → 'derivatives standards')",
      "Check related initiatives (ISO 20022, FpML, DLT)"
    ],
    "informative_absence_assessment": {
      "question": "Would we EXPECT to find evidence in this category if bank were ARCHITECT?",
      "if_yes": "Absence SUPPORTS PRAGMATIST hypothesis",
      "if_no": "Absence is NEUTRAL"
    }
  },

  "usage_instructions": {
    "placeholder_replacement": "Replace [BANK], [DOMAIN], [REGULATOR], [YEAR], [PRODUCT] with actual values",
    "minimum_searches_per_tier": 15,
    "results_to_review_per_query": 20,
    "reformulation_iterations_for_null": 4,
    "document_all_null_results": true
  }
