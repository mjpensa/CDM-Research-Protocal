{
  "$schema": "CDM/DRR Search Templates v1.0",
  "version": "1.0-20251221",
  "description": "Externalized search query templates for Evidence Gatherer Agent",
  "last_updated": "2025-12-21",

  "placeholders": {
    "BANK": "Bank name (e.g., 'Deutsche Bank')",
    "DOMAIN": "Bank's primary domain (e.g., 'db.com')",
    "REGULATOR": "Primary regulator domain (e.g., 'bafin.de')",
    "YEAR": "Current or target year (e.g., 2024)",
    "PRODUCT": "Product category (e.g., 'IRS', 'CDS')"
  },

  "tier1": {
    "description": "Official Sources - Definitive Weight (Max Confidence: 95%)",
    "bank_official": {
      "description": "Bank press releases and announcements",
      "queries": [
        "\"[BANK]\" \"Common Domain Model\" site:[DOMAIN]",
        "\"[BANK]\" CDM derivatives technology announcement",
        "\"[BANK]\" pilot production timeline regulatory reporting",
        "\"[BANK]\" \"Digital Regulatory Reporting\" announcement"
      ]
    },
    "annual_reports": {
      "description": "Annual reports and investor presentations",
      "queries": [
        "\"[BANK]\" annual report [YEAR] \"derivatives\" \"technology\"",
        "\"[BANK]\" annual report [YEAR-1] \"regulatory reporting\" \"modernization\"",
        "\"[BANK]\" investor presentation [YEAR] filetype:pdf",
        "\"[BANK]\" investor day derivatives technology"
      ]
    },
    "isda_official": {
      "description": "ISDA official publications",
      "queries": [
        "site:isda.org \"[BANK]\" CDM",
        "site:isda.org \"[BANK]\" \"Common Domain Model\"",
        "site:isda.org \"[BANK]\" contributor",
        "site:isda.org \"[BANK]\" DRR \"Digital Regulatory Reporting\""
      ]
    },
    "finos_official": {
      "description": "FINOS official repositories",
      "queries": [
        "site:finos.org \"[BANK]\"",
        "site:github.com/finos \"[BANK]\" CDM",
        "\"[BANK]\" FINOS contributor CDM",
        "site:github.com/finos/common-domain-model \"[BANK]\""
      ]
    },
    "regulatory": {
      "description": "Regulatory filings and announcements",
      "queries": [
        "site:[REGULATOR] \"[BANK]\" derivatives reporting",
        "\"[BANK]\" EMIR Refit implementation",
        "\"[BANK]\" UK EMIR implementation",
        "\"[BANK]\" regulatory filing derivatives technology"
      ]
    }
  },

  "tier2": {
    "description": "Industry Sources - Strong Weight (Max Confidence: 75%)",
    "trade_press": {
      "description": "Trade press coverage",
      "queries": [
        "\"[BANK]\" \"Common Domain Model\" site:risk.net",
        "\"[BANK]\" CDM DRR site:waterstechnology.com",
        "\"[BANK]\" derivatives technology transformation Risk.net OR Waters",
        "\"[BANK]\" regulatory reporting modernization [YEAR] [YEAR-1]",
        "site:fnlondon.com \"[BANK]\" derivatives technology"
      ]
    },
    "isda_events": {
      "description": "ISDA events and working groups",
      "queries": [
        "\"[BANK]\" ISDA AGM [YEAR] speaker",
        "\"[BANK]\" ISDA AGM [YEAR-1] speaker CDM",
        "\"[BANK]\" ISDA working group CDM",
        "ISDA conference \"[BANK]\" derivatives standards"
      ]
    },
    "finos_activity": {
      "description": "FINOS contribution activity",
      "queries": [
        "site:github.com/finos commits \"[BANK]\"",
        "FINOS CDM working group \"[BANK]\" participant",
        "\"[BANK]\" FINOS open source contribution"
      ]
    },
    "industry_analysis": {
      "description": "Analyst reports and industry coverage",
      "queries": [
        "\"[BANK]\" derivatives technology investment CDM",
        "\"[BANK]\" post-trade modernization Celent OR \"Oliver Wyman\"",
        "\"[BANK]\" regulatory technology Chartis OR Aite",
        "\"[BANK]\" derivatives operations McKinsey"
      ]
    },
    "conference_proceedings": {
      "description": "Conference speaker listings",
      "queries": [
        "\"[BANK]\" speaker derivatives technology conference [YEAR]",
        "\"[BANK]\" presented CDM implementation",
        "\"[BANK]\" speaker regulatory reporting conference"
      ]
    }
  },

  "tier3": {
    "description": "Indirect Signals - Moderate Weight (Max Confidence: 50%)",
    "job_postings": {
      "description": "CDM-related job postings",
      "queries": [
        "\"[BANK]\" job posting \"Common Domain Model\"",
        "\"[BANK]\" careers CDM \"regulatory reporting\"",
        "\"[BANK]\" hiring derivatives technology CDM",
        "site:linkedin.com/jobs \"[BANK]\" CDM"
      ]
    },
    "linkedin_profiles": {
      "description": "LinkedIn profiles mentioning CDM work",
      "queries": [
        "site:linkedin.com \"[BANK]\" \"Common Domain Model\"",
        "site:linkedin.com \"[BANK]\" CDM implementation",
        "\"[BANK]\" employee derivatives technology CDM LinkedIn"
      ]
    },
    "vendor_announcements": {
      "description": "Vendor claims of bank relationships",
      "queries": [
        "\"Delta Capita\" \"[BANK]\" CDM",
        "\"Fragmos Chain\" \"[BANK]\"",
        "\"REGnosys\" \"[BANK]\"",
        "vendor \"[BANK]\" \"Common Domain Model\" client"
      ]
    },
    "technology_press": {
      "description": "General technology press",
      "queries": [
        "\"[BANK]\" derivatives platform upgrade [YEAR]",
        "\"[BANK]\" post-trade infrastructure modernization"
      ]
    }
  },

  "product_specific": {
    "description": "v4.0: Product-level intelligence gathering",
    "products": ["IRS", "CDS", "FX_Options", "Equity_Derivatives", "Commodities"],
    "product_aliases": {
      "IRS": ["Interest Rate Swaps", "rates", "interest rate derivatives"],
      "CDS": ["Credit Default Swaps", "credit derivatives"],
      "FX_Options": ["FX options", "currency derivatives", "forex options"],
      "Equity_Derivatives": ["Equity swaps", "equity options", "TRS", "total return swaps"],
      "Commodities": ["Commodity swaps", "energy derivatives", "commodity derivatives"]
    },
    "patterns": {
      "product_cdm": [
        "\"[BANK]\" \"[PRODUCT]\" CDM OR \"Common Domain Model\"",
        "\"[BANK]\" \"[PRODUCT]\" regulatory reporting technology",
        "\"[BANK]\" \"[PRODUCT]\" post-trade modernization"
      ],
      "product_regulatory": [
        "\"[BANK]\" \"[PRODUCT]\" \"EMIR Refit\" implementation",
        "\"[BANK]\" \"[PRODUCT]\" CFTC reporting upgrade",
        "\"[BANK]\" \"[PRODUCT]\" trade repository connectivity"
      ],
      "product_volume": [
        "\"[BANK]\" derivatives notional [YEAR] annual report",
        "\"[BANK]\" \"[PRODUCT]\" market maker OR dealer",
        "\"[BANK]\" derivatives revenue breakdown by asset class"
      ]
    }
  },

