{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CDM/DRR Evidence Documentation Schema v3.1",
  "description": "Documents the structure of research outputs. Primary output format is JSON (Ledger-First principle); Markdown files are rendered views for human readability.",
  "version": "3.1",
  "last_updated": "2025-12-20",

  "output_format": "json",
  "note": "Per CLAUDE.md Ledger-First mandate: evidence.json is the PRIMARY output. Markdown tier*-evidence.md files are RENDERED from JSON. All downstream agents (Bayesian, Gates, Adversarial) read from evidence.json.",

  "evidence_json_structure": {
    "filename": "evidence.json",
    "location": "outputs/phase-[N]/[bank_id]/",
    "description": "Primary evidence ledger. Agent appends items after each tier; do not overwrite.",
    "schema": {
      "bank_id": {
        "type": "string",
        "description": "Lowercase hyphenated identifier (e.g., 'deutsche-bank')"
      },
      "bank_name": {
        "type": "string",
        "description": "Full display name (e.g., 'Deutsche Bank AG')"
      },
      "schema_version": {
        "type": "string",
        "default": "3.1"
      },
      "evidence_items": {
        "type": "array",
        "items": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]+$",
            "description": "Evidence ID (e.g., 'BANK-001')"
          },
          "claim": {
            "type": "string",
            "description": "Description of the finding"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "description": "Full URL to source"
          },
          "tier": {
            "type": "integer",
            "enum": [1, 2, 3],
            "description": "Evidence tier (1=Official, 2=Industry, 3=Indirect)"
          },
          "claim_type": {
            "type": "string",
            "enum": ["production_usage", "pilot_or_poc", "membership_or_participation", "open_source_contribution", "vendor_proxy_signal", "hiring_signal"],
            "description": "Classification of claim type per CLAUDE.md Section 3"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Publication date (YYYY-MM-DD)"
          },
          "direction": {
            "type": "string",
            "enum": ["SUPPORTS_ARCHITECT", "SUPPORTS_PRAGMATIST", "NEUTRAL"],
            "description": "Which hypothesis this evidence supports"
          },
          "quality_assessment": {
            "type": "object",
            "properties": {
              "authority": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]},
              "recency": {"type": "string", "enum": ["current", "dated", "historical"]},
              "specificity": {"type": "string", "enum": ["specific", "moderate", "vague"]}
            }
          },
          "excerpt": {
            "type": "string",
            "description": "Exact quote from source"
          },
          "caveats": {
            "type": "string",
            "description": "Limitations or alternative interpretations"
          },
          "lr_mapping": {
            "type": "object",
            "description": "Likelihood ratio mapping for Bayesian updates",
            "properties": {
              "evidence_type": {
                "type": "string",
                "description": "Key from config/bayesian-lr-tables.json"
              },
              "likelihood_ratio": {
                "type": "number",
                "description": "LR value (>1 supports Architect, <1 supports Pragmatist)"
              }
            }
          }
        }
      },
      "null_results": {
        "type": "array",
        "items": {
          "category": {"type": "string"},
          "queries": {"type": "array", "items": {"type": "string"}},
          "results_reviewed": {"type": "integer"},
          "null_type": {"type": "string", "enum": ["NO_RESULTS", "IRRELEVANT", "PAYWALLED", "OUTDATED_ONLY"]},
          "informative_absence": {"type": "boolean"},
          "implication": {"type": "string"}
        }
      },
      "meta": {
        "type": "object",
        "properties": {
          "tier_completed": {"type": "integer", "description": "Highest tier completed (1, 2, or 3)"},
          "generated_at": {"type": "string", "format": "date-time"},
          "searches_executed": {"type": "integer"},
          "evidence_hash": {"type": "string", "description": "SHA256 of evidence_items for integrity"}
        }
      }
    }
  },

  "rendered_markdown_files": {
    "description": "Markdown files are RENDERED from evidence.json for human readability. These are secondary outputs.",
    "files": ["tier1-evidence.md", "tier2-evidence.md", "tier3-evidence.md", "null-results.md"],
    "renderer": "tools/render_evidence_md.py"
  },

  "evidence_file_structure": {
    "_note": "These Markdown structures are RENDERED from evidence.json. They are secondary outputs for human readability.",
    "tier_evidence_md": {
      "filename_pattern": "tier[N]-evidence.md",
      "location": "outputs/phase-[N]/[bank_id]/1-evidence/",
      "source": "Rendered from evidence.json by tools/render_evidence_md.py",
      "sections": [
        "# Tier [N] Evidence: [Bank Name]",
        "## Search Execution Summary",
        "- Execution Tier: [A/B/C]",
        "- Date: [YYYY-MM-DD]",
        "- Searches Executed: [Count]",
        "- Evidence Blocks Found: [Count]",
        "- Null Results: [Count]",
        "## Evidence Inventory",
        "[BANK-XXX] TIER [N] — [SUPPORTS/UNDERMINES/NEUTRAL] [Classification]",
        "Source: [source name and URL]",
        "Date: [YYYY-MM-DD]",
        "Finding: [quote or summary]",
        "Quality Assessment:",
        "- Authority: [High/Medium/Low]",
        "- Recency: [Current/Dated/Historical]",
        "- Specificity: [Specific/Moderate/Vague]",
        "- Corroborated: [Yes/No - pending]",
        "Confidence: [HIGH/MEDIUM/LOW]",
        "Reasoning: [one sentence]",
        "Caveats: [limitations]"
      ]
    },
    "null_results_md": {
      "filename_pattern": "null-results.md",
      "location": "outputs/phase-[N]/[bank_id]/1-evidence/",
      "sections": [
        "# Null Results: [Bank Name]",
        "## Summary",
        "- Total Search Categories: [Count]",
        "- Categories with Null Results: [Count]",
        "- Informative Absences: [Count]",
        "## Null Result Blocks",
        "Search Category: [category name]",
        "Queries Executed: [list]",
        "Results Reviewed: [count]",
        "Relevant Findings: 0",
        "Null Classification: [NO_RESULTS/IRRELEVANT/PAYWALLED/OUTDATED_ONLY]",
        "Informative Absence Assessment: [YES/NO/UNCLEAR]",
        "Implication: [what absence suggests]"
      ]
    }
  },

  "status_json_structure": {
    "filename": "status.json",
    "location": "outputs/phase-[N]/[bank_id]/",
    "required_fields": {
      "bank_id": "string - lowercase hyphenated identifier",
      "bank_name": "string - full display name",
      "phase": "integer - phase number (1-7)",
      "classification": "enum - ARCHITECT | PRAGMATIST | UNKNOWN",
      "sub_classification": "string - variant name from taxonomy",
      "confidence": "number - 0-100 percentage",
      "status": "enum - pending | in_progress | completed",
      "current_stage": "string - current workflow stage"
    },
    "optional_fields": {
      "probability_architect": "number - 0.0 to 1.0",
      "probability_pragmatist": "number - 0.0 to 1.0",
      "prior_probability": "number - starting probability",
      "evidence_count": "object - {tier1, tier2, tier3, null_results}",
      "last_updated": "string - ISO 8601 timestamp",
      "notes": "string - additional context"
    }
  },

  "classification_taxonomy": {
    "valid_classifications": ["ARCHITECT", "PRAGMATIST", "OBSERVER", "UNKNOWN"],
    "valid_sub_classifications": {
      "ARCHITECT": ["Native", "Leader", "Follower"],
      "PRAGMATIST": ["Vendor-Dependent", "Integration-Constrained", "Regulatory-Driven", "Network-Accelerant"],
      "OBSERVER": ["Active-Watcher", "Passive"],
      "UNKNOWN": ["Insufficient-Evidence", "Conflicting-Evidence"]
    },
    "deprecated_terms": {
      "NOT_ENGAGED": "Use PRAGMATIST with appropriate sub-classification",
      "NON-ARCHITECT": "Use PRAGMATIST with appropriate sub-classification",
      "CDM User": "Use PRAGMATIST Vendor-Dependent"
    }
  },

  "optional_json_processing": {
    "description": "The following fields are used by optional Python tools for advanced verification",
    "tools": ["tools/process_evidence.py", "tools/trust_audit.py"],
    "fields": {
      "verification": {
        "status": "enum - VERIFIED|ARCHIVED|PAYWALLED|DEAD|ERROR|PENDING",
        "live_ok": "boolean",
        "archive_ok": "boolean",
        "last_verified": "ISO timestamp"
      },
      "content": {
        "hash_sha256": "string - content hash for drift detection",
        "byte_length": "integer",
        "archive_url": "string - Wayback Machine URL",
        "content_changed": "boolean - drift detection flag"
      },
      "trust_metrics": {
        "overall_confidence": "number 0-100",
        "corroboration_rate": "number 0-1",
        "verification_rate": "number 0-1",
        "flags": "array of trust flag strings"
      }
    }
  },

  "trust_flags": {
    "description": "Flags that can be raised by trust_audit.py",
    "values": [
      "SINGLE_SOURCE_CLAIM",
      "STALE_EVIDENCE",
      "UNVERIFIED_URLS",
      "CONTRADICTIONS_DETECTED",
      "LOW_TIER_ONLY",
      "CONTENT_DRIFT_DETECTED",
      "MISSING_CORROBORATION",
      "DUPLICATE_IDS",
      "EXCERPTS_NOT_VERIFIED",
      "TIER_AUTHORITY_MISMATCH"
    ]
  },

  "deprecated_v2_fields": {
    "note": "The following fields from schema v2.3 are documented for reference but not required in Markdown workflow",
    "fields": ["meta.provenance", "evidence_items.verification", "evidence_items.content.hash_history"]
  }
}
